{
  "name": "obsidian-theme-claude",
  "version": "1.0.0",
  "private": true,
  "description": "An unofficial Claude-inspired theme for Obsidian.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "node tools/clean.mjs",
    "build": "node tools/build-theme.mjs",
    "sync:fonts": "node tools/sync-open-fonts.mjs",
    "check": "npm run check:metadata && npm run lint:theme",
    "check:metadata": "node tools/check-metadata.mjs",
    "lint:theme": "node tools/lint-theme.mjs",
    "package": "pwsh -NoProfile -File tools/package.ps1"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@fontsource-variable/source-code-pro": "5.3.0",
    "sass": "1.104.1",
    "stylelint": "17.15.0",
    "stylelint-config-obsidianmd": "0.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
